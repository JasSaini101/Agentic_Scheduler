GOOGLE_CALENDAR_ID=primary
ANTHROPIC_API_KEY=
OPENWEATHERMAP_API_KEY=
OURA_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
PLANET_FITNESS_PLACE_ID=

# ── Observability (LangSmith) ───────────────────────────────────────────────
# Set these to trace every chain/graph run (agent nodes, critic loop, LLM
# calls) in LangSmith — no code changes needed, LangChain/LangGraph pick
# these up automatically. https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-scheduler

# ── Render / hosted deployment ──────────────────────────────────────────────
# Paste the full contents of credentials.json as a single-line JSON string
GOOGLE_CREDENTIALS_JSON=
# Your deployed URL — used as the OAuth redirect base
BASE_URL=https://your-app.onrender.com

# ── Multi-user auth ─────────────────────────────────────────────────────────
# Secret for signing the login cookie — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Comma-separated Google emails allowed to sign in. Empty = anyone who
# completes the OAuth flow (Google Console test-user list still applies).
AUTHORIZED_EMAILS=
# Postgres URL (e.g. Neon) for per-user tokens & sessions when hosted.
# Leave empty locally — a SQLite file (scheduler.db) is used instead.
DATABASE_URL=

# Timezone used to resolve "today" and day names, and stamped on calendar
# events. Set this on Render/any UTC server, or evening requests will date
# everything one day ahead of what your browser shows.
SCHEDULER_TZ=America/Los_Angeles

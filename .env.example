GOOGLE_CALENDAR_ID=primary
ANTHROPIC_API_KEY=
OPENWEATHERMAP_API_KEY=
OURA_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
PLANET_FITNESS_PLACE_ID=

# ── Render / hosted deployment ──────────────────────────────────────────────
# Paste the full contents of credentials.json as a single-line JSON string
GOOGLE_CREDENTIALS_JSON=
# Paste the token JSON after first OAuth login (from GET /api/token?key=...)
GOOGLE_TOKEN_JSON=
# One-time secret to enable GET /api/token. Set it, export the token, then REMOVE it.
TOKEN_EXPORT_KEY=
# Your deployed URL — used as the OAuth redirect base
BASE_URL=https://your-app.onrender.com
